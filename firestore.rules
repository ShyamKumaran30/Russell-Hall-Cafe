rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if requesting user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: Check if user document exists and get user role
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check if user document exists and has admin/manager/superadmin role
    function hasAdminRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData().role == 'admin' || getUserData().role == 'superadmin' || getUserData().role == 'manager');
    }

    // Helper: Check if user document exists and has kitchen role
    function hasKitchenRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'kitchen';
    }

    // Helper: Check if user is Admin, Manager, or Superadmin
    function isAdmin() {
      return isAuth() && 
        (request.auth.token.email.matches('.*@russellhallcafe\\.co\\.uk') || 
         request.auth.token.email.matches('.*@rhbrunch\\.co\\.uk') ||
         hasAdminRole());
    }

    // Helper: Check if user is Kitchen, Manager, Admin, or Superadmin
    function isKitchen() {
      return isAuth() && 
        (request.auth.token.email.matches('.*@russellhallcafe\\.co\\.uk') || 
         request.auth.token.email.matches('.*@rhbrunch\\.co\\.uk') ||
         hasAdminRole() ||
         hasKitchenRole());
    }

    // ─── USERS ────────────────────────────────────────────────────────────────
    // IMPORTANT: 'list' is separate from 'get' — queries need list permission.
    // resource.data is null during list, so we cannot check userId there.
    match /users/{userId} {
      allow get:    if isAuth() && (request.auth.uid == userId || isKitchen());
      allow list:   if isAuth() && isKitchen();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── ORDERS ───────────────────────────────────────────────────────────────
    // KEY FIX: 'allow read' with resource.data CRASHES on list/query operations
    // because resource is NULL during collection queries (not single-doc reads).
    // The old rule "allow read: if resource.data.userId == uid" blocked ALL
    // queries (track order, admin orders, kitchen queue) silently with no error.
    //
    // Fix: separate 'get' (single document — resource exists) from
    //      'list' (queries — resource is null, we trust the query filter).
    // Customers query WHERE userId==uid so they only see their own orders.
    // Kitchen/admin query by status so they see all — both are safe.
    match /orders/{orderId} {
      allow create: if isAuth() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow get:    if isAuth() && (resource.data.userId == request.auth.uid || isKitchen());
      allow list:   if isAuth();
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isKitchen());
      allow delete: if isAdmin();
    }

    // ─── BOOKINGS ─────────────────────────────────────────────────────────────
    // Same fix applied — split read into get + list.
    match /bookings/{bookingId} {
      allow create: if isAuth() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow get:    if isAuth() && (resource.data.userId == request.auth.uid || isKitchen());
      allow list:   if isAuth();
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isKitchen());
      allow delete: if isAdmin();
    }

    // ─── CATEGORIES & MENU ITEMS (public read, admin write) ──────────────────
    match /categories/{categoryId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }
    match /menuItems/{itemId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // ─── TABLES (public read — needed for live floor plan) ───────────────────
    match /tables/{tableId} {
      allow read, list: if true;
      allow write: if isKitchen();
    }

    // ─── DAILY SPECIALS (public read) ────────────────────────────────────────
    match /dailySpecials/{specialId} {
      allow read, list: if true;
      allow update: if isAuth();
      allow create, delete: if isAdmin();
    }

    // ─── STAFF ROTA ──────────────────────────────────────────────────────────
    match /staffRota/{rotaId} {
      allow read, list: if isKitchen();
      allow write: if isAdmin();
    }

    // ─── INVENTORY ───────────────────────────────────────────────────────────
    match /inventory/{itemId} {
      allow read, list, write: if isKitchen();
      allow delete: if isAdmin();
    }

    // ─── INVENTORY LOGS ──────────────────────────────────────────────────────
    match /inventoryLog/{logId} {
      allow read, list, write: if isKitchen();
      allow delete: if isAdmin();
    }

    // ─── WASTE LOGS ──────────────────────────────────────────────────────────
    match /wasteLog/{logId} {
      allow read, list, write: if isKitchen();
      allow delete: if isAdmin();
    }

    // ─── SUPPLIERS ───────────────────────────────────────────────────────────
    match /suppliers/{supplierId} {
      allow read, list: if isKitchen();
      allow write, delete: if isAdmin();
    }

    // ─── PURCHASE ORDERS ─────────────────────────────────────────────────────
    match /purchaseOrders/{poId} {
      allow read, list, write: if isKitchen();
      allow delete: if isAdmin();
    }

    // ─── AUDIT LOGS ──────────────────────────────────────────────────────────
    match /auditLog/{logId} {
      allow read, list: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if false;
    }
  }
}
